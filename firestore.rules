rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Roles are dynamic: admins/{uid}.role must exist and is not "pending".
    // get()/exists() on a missing doc fails, which denies the request.
    function adminExists() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function getRole() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && adminExists() && getRole() != "pending";
    }

    function isCTO() {
      return isAuthenticated() && adminExists() && getRole() == "CTO";
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // --- Users ---
    // Students read and edit only their own profile. Student search goes through /api/registrations.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isCTO();
    }

    match /pending_registrations/{userId} {
      allow create: if isOwner(userId);
      allow read: if isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // --- Admin profiles ---
    // Only the CTO assigns roles. Admins may edit their own profile details and
    // finish onboarding. The public team list on /about is served by the server,
    // not read from here.
    match /admins/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.role == 'pending'
        && request.resource.data.keys().hasOnly(['uid', 'email', 'role', 'createdAt']);
      allow update: if isCTO()
        || (isOwner(userId)
            && changedKeys().hasOnly(['displayName', 'photoURL', 'rollNo', 'dob', 'socials', 'status'])
            && (!('status' in changedKeys())
                || (resource.data.status == 'onboarding' && request.resource.data.status == 'active')));
      allow delete: if isOwner(userId) || isCTO();
    }

    // --- Club roles (role catalog with permissions) ---
    match /club_roles/{roleId} {
      allow read: if true;
      allow write: if isCTO();
    }

    // --- Public content: public read, admin write ---
    match /events/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Attendance codes, kept out of the public event docs. Check-in is verified by /api/registrations.
    match /event_secrets/{eventId} {
      allow read, write: if isAdmin();
    }

    match /gallery/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /projects/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /resources/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /team_core/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /team_mentors/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /alumni/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Legacy image-metadata collections.
    match /event_images/{imageId} {
      allow read: if isAdmin();
      allow write: if isCTO();
    }

    match /resource_images/{imageId} {
      allow read: if isAuthenticated();
      allow write: if isCTO();
    }

    // --- Contact form: anyone can send, admins read ---
    match /messages/{document} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'subject', 'message', 'timestamp', 'solved'])
        && request.resource.data.keys().hasAll(['name', 'email', 'subject', 'message', 'timestamp'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000;
      allow read, delete: if isAdmin();
      // The only admin writes are the workflow flags: marking a message solved
      // (or reopening it), the timestamp of that action, and an optional
      // follow-up reminder. Nothing else on a contact message can change.
      // Message workflow updates (solved/reminder) require an active admin,
      // excluding onboarding admins who have not been granted full privileges.
      allow update: if isAdmin() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.status != 'onboarding'
        && changedKeys().hasOnly(['solved', 'solvedAt', 'reminderAt'])
        && (!('solved' in changedKeys()) || request.resource.data.solved is bool)
        && (!('solvedAt' in changedKeys()) || request.resource.data.solvedAt == null || request.resource.data.solvedAt is timestamp)
        && (!('reminderAt' in changedKeys()) || request.resource.data.reminderAt == null || request.resource.data.reminderAt is timestamp);
    }

    match /audit_logs/{document} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.actorUid == request.auth.uid;
      allow update: if false;
      allow delete: if isCTO();
    }

    // --- Registrations, invitations and feedback ---
    // Students write these only through /api/registrations (Admin SDK).
    // A student can read a registration only if they are on it; reading a missing doc is allowed
    // so the client can check whether it is registered.
    match /registrations/{document} {
      allow get: if isAdmin() || (isAuthenticated() && (resource == null || request.auth.uid in resource.data.participantIds));
      allow list: if isAdmin() || (isAuthenticated() && request.auth.uid in resource.data.participantIds);
      allow write: if isAdmin();
    }

    // Invitations hold names, roll numbers and team names only. Leaders list them by registrationId.
    match /invitations/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /feedbacks/{document} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if isAdmin();
      allow write: if isCTO();
    }
  }
}
